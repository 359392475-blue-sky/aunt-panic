# 复制为 .env 后填入真实值，.env 不要提交到 git

# ========== DeepSeek ==========
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ========== 服务运行 ==========
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_PUBLIC_BASE_URL=http://localhost:8000

# ========== 数据 ==========
DATABASE_PATH=./.data/cache.sqlite
THUMBNAIL_CACHE_DIR=./.data/thumbnails
IMAGE_STORE_DIR=./.data/images
IMAGE_RETAIN_DAYS=7

# ========== 长图渲染 ==========
LONGIMAGE_WIDTH=750
LONGIMAGE_DEVICE_SCALE=2

# ========== 日志 ==========
LOG_LEVEL=INFO
